
name: Update GitHub Project Issue Status

on:
  push:
    branches:
      - 'release-Raptor-*'
      - 'release-RaptorService-*'

permissions:
  contents: read

jobs:
  update-project:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Process referenced issues
        env:
          GH_TOKEN: ${{ secrets.PROJECTS_TOKEN }}
          REPO_OWNER: mhe890205kj8-hue
          REPO_NAME: novaapp
          BRANCH: ${{ github.ref_name }}
          BEFORE: ${{ github.event.before }}
          AFTER: ${{ github.event.after }}
        shell: bash
        run: |
          set -euo pipefail

          # Select the Project based on the exact branch pattern.
          if [[ "$BRANCH" =~ ^release-Raptor-([0-9]+\.[0-9]+)$ ]]; then
            PROJECT_NUMBER=11
            PROJECT_ID="PVT_kwHOECsPhs4BtFjj"
            FIELD_ID="PVTSSF_lAHOECsPhs4BtFjjzhrQqEA"
            FROM_OPTION="c39ef371"
            TARGET_OPTION="7765758d"
            echo "Selected Raptor test project."

          elif [[ "$BRANCH" =~ ^release-RaptorService-([0-9]+\.[0-9]+)$ ]]; then
            PROJECT_NUMBER=12
            PROJECT_ID="PVT_kwHOECsPhs4BtFjk"
            FIELD_ID="PVTSSF_lAHOECsPhs4BtFjkzhrQqFA"
            FROM_OPTION="965977d8"
            TARGET_OPTION="8d28a959"
            echo "Selected RaptorService test project."

          else
            echo "Branch does not match a supported sprint pattern."
            exit 0
          fi

          echo "Project number: $PROJECT_NUMBER"
          echo "Branch: $BRANCH"

          # Get commit messages included in this push.
          if [[ "$BEFORE" =~ ^0+$ ]]; then
            COMMIT_MESSAGES=$(git show -s --format=%B "$AFTER")
          else
            COMMIT_MESSAGES=$(git log --format=%B "$BEFORE..$AFTER")
          fi

          # Extract unique issue references such as #123.
          ISSUES=$(printf '%s\n' "$COMMIT_MESSAGES" |
            grep -Eo '#[0-9]+' |
            tr -d '#' |
            sort -u || true)

          if [[ -z "$ISSUES" ]]; then
            echo "No issue references found in pushed commits."
            exit 0
          fi

          echo "Issues detected:"
          echo "$ISSUES"

          for ISSUE_NUMBER in $ISSUES; do
            echo ""
            echo "Processing issue #$ISSUE_NUMBER"

            # Find this issue's items in the selected Project.
            RESULT=$(gh api graphql \
              -f query='
                query(
                  $owner: String!,
                  $name: String!,
                  $issueNumber: Int!
                ) {
                  repository(owner: $owner, name: $name) {
                    issue(number: $issueNumber) {
                      projectItems(first: 100) {
                        nodes {
                          id
                          project {
                            id
                          }
                          fieldValues(first: 20) {
                            nodes {
                              ... on ProjectV2ItemFieldSingleSelectValue {
                                optionId
                                field {
                                  ... on ProjectV2SingleSelectField {
                                    id
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }' \
              -F owner="$REPO_OWNER" \
              -F name="$REPO_NAME" \
              -F issueNumber="$ISSUE_NUMBER")

            ITEM_ROWS=$(echo "$RESULT" | jq -r \
              --arg project "$PROJECT_ID" \
              --arg field "$FIELD_ID" '
                [
                  .data.repository.issue.projectItems.nodes[]?
                  | select(.project.id == $project)
                  | {
                      itemId: .id,
                      optionId: (
                        [
                          .fieldValues.nodes[]?
                          | select(.field.id == $field)
                          | .optionId
                        ][0] // ""
                      )
                    }
                ]
                | .[]
                | [.itemId, .optionId]
                | @tsv
              ')

            if [[ -z "$ITEM_ROWS" ]]; then
              echo "Issue #$ISSUE_NUMBER is not in Project $PROJECT_NUMBER."
              continue
            fi

            while IFS=$'\t' read -r ITEM_ID CURRENT_OPTION; do

              if [[ "$CURRENT_OPTION" == "$TARGET_OPTION" ]]; then
                echo "Issue #$ISSUE_NUMBER is already Ready for next beta."
                continue
              fi

              if [[ "$CURRENT_OPTION" != "$FROM_OPTION" ]]; then
                echo "Issue #$ISSUE_NUMBER is not In development. Skipping."
                continue
              fi

              echo "Updating issue #$ISSUE_NUMBER..."

              gh api graphql \
                -f query='
                  mutation(
                    $projectId: ID!,
                    $itemId: ID!,
                    $fieldId: ID!,
                    $optionId: String!
                  ) {
                    updateProjectV2ItemFieldValue(
                      input: {
                        projectId: $projectId,
                        itemId: $itemId,
                        fieldId: $fieldId,
                        value: {
                          singleSelectOptionId: $optionId
                        }
                      }
                    ) {
                      projectV2Item {
                        id
                      }
                    }
                  }' \
                -F projectId="$PROJECT_ID" \
                -F itemId="$ITEM_ID" \
                -F fieldId="$FIELD_ID" \
                -F optionId="$TARGET_OPTION"

              echo "Issue #$ISSUE_NUMBER updated successfully."

            done <<< "$ITEM_ROWS"

          done
